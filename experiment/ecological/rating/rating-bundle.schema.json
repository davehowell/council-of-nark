{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://davehowell.github.io/council-of-nark/schema/ecological-rating-bundle-v1.json",
  "title": "Blinded ecological absolute-rating bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "study_label", "task", "outputs"],
  "properties": {
    "schema_version": { "const": 1 },
    "bundle_id": { "type": "string", "pattern": "^rb-[a-f0-9]{16,64}$" },
    "study_label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "task": { "$ref": "#/$defs/task" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "problem_statement", "reference"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "problem_statement": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "reference": { "$ref": "#/$defs/reference" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "title", "source", "summary", "patch", "tests"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source": { "type": "string", "minLength": 1, "maxLength": 300 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "patch": { "type": "string", "minLength": 1, "maxLength": 200000 },
        "tests": { "type": "string", "minLength": 1, "maxLength": 100000 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_id", "review"],
      "properties": {
        "output_id": { "type": "string", "pattern": "^rv-[a-f0-9]{16,64}$" },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_summary", "findings", "uncertainties"],
      "properties": {
        "review_summary": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/finding" }
        },
        "uncertainties": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 5000 }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "locations", "claim", "mechanism", "consequence", "correction", "allocation_and_scope", "regression_tests", "evidence", "confidence"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/location" }
        },
        "claim": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "mechanism": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "consequence": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "correction": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "allocation_and_scope": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "regression_tests": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/test" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 5000 }
        },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "expected", "why_discriminating"],
      "properties": {
        "case": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "expected": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "why_discriminating": { "type": "string", "minLength": 1, "maxLength": 5000 }
      }
    }
  }
}
